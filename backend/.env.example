APP_NAME=Sanggah
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite quick start (default). Run commands from the backend folder.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL — comment the two SQLite lines above and use these instead:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sanggah
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sanggah.test"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated browser origins allowed to call the API.
# Add the Vercel origin here when the frontend is deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Local demo admin. Change this before any public deployment.
DEMO_ADMIN_EMAIL=juri@sanggah.test
DEMO_ADMIN_PASSWORD=Sanggah-Juri-2026
DEMO_ADMIN_NAME="Juri AIWIC"

# AI. Leave keys empty to use the offline MockProvider.
# Set AI_PROVIDER to gemini or qwen when a key is present.
# The other configured provider is the automatic fallback.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3-vl-flash
QWEN_VISION_MODEL=qwen3-vl-flash
AI_TIMEOUT_S=20
AI_MAX_RETRY=1
AI_DAILY_BUDGET_CALLS=200
AI_FORCE_FAIL=false
SCAN_CONFIDENCE_THRESHOLD=0.6
SCAN_MAX_BYTES=8388608
CALENDAR_MAX_RANGE_DAYS=62
CORPUS_VERSION=2026.1
RULES_VERSION=2026.1
